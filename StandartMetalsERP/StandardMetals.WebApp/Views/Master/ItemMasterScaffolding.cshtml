@*below code is off Item Information*@

<section id="ItemInfo">
    <div class="col-lg-12 col-md-12">
        <div class="box box-info">

            <div class="box-header with-border">
                <h3 class="box-title">Item Information</h3>

                <div class="box-tools pull-right">
                    <button type="button" class="btn btn-box-tool" data-widget="collapse">
                        <i class="fa fa-minus"></i>
                    </button>
                </div>
                <!-- /.box-tools -->
            </div>

            @using (Html.BeginForm(new { @id ="Form"}))
            {
                <div class="box-body">

                    <table class="table-condensed table-hover table-responsive" width="100%">
                        <tbody>
                            <tr>
                                <th style="width: 15%"></th>
                                <th style="width: 35%">
                                    @Html.CheckBoxFor(model => model.RawMaterial, new { @class = "form-check-input" })
                                    Raw material
                                </th>
                                <th style="width: 15%"></th>
                                <th style="width: 35%"></th>
                            </tr>

                            <tr>
                                <th width="15%">Item Code</th>
                                <td width="35%">

                                    @*@Html.EditorFor(model => model.ItemCode, new { htmlAttributes = new { @class = "form-control input-sm",@id= "txtItemCode" } })*@
                                    <input id="txtItemCode" class="form-control input-sm" type="text" readonly />
                                    @Html.ValidationMessageFor(model => model.ItemCode, "", new { @class = "text-danger" })
                                </td>


                                <th width="15%">Item Name</th>
                                <td width="35%">
                                    @*@Html.EditorFor(model => model.ItemName, new { htmlAttributes = new { @class = "form-control input-sm",@id= "txtItemName" } })*@
                                    <input id="txtItemName" class="form-control input-sm" type="text"  />
                                    @Html.ValidationMessageFor(model => model.ItemName, "", new { @class = "text-danger" })

                                </td>

                            </tr>

                            <tr>
                                <th width="15%">Manufacturer</th>
                                <td width="35%">

                                    <div class="dropdown">
                                        <select id="drpManufacturer" class="form-control  col-sm-6" style="margin-bottom: 5px;">
                                        <option value="-1" lang="en">-Select-</option>
                                        </select>
                                        @*@Html.DropDownListFor(model => model.ManufacturerId,null, new { @class = "form-control select2",@id= "drpManufacturer" })*@
                                        @*@Html.DropDownListFor(model => model.ManufacturerId, new { htmlAttributes = new { @class = "form-control input-sm", @id = "drpManufacturer" } })*@
                                        @Html.ValidationMessageFor(model => model.ManufacturerId, "", new { @class = "text-danger" })
                                    </div>
                                </td>
                                <th width="15%">Material</th>
                                <td width="35%">
                                    @*@Html.EditorFor(model => model.Material, new { htmlAttributes = new { @class = "form-control input-sm",@id= "txtItemMaterial" } })*@
                                    <input id="txtItemMaterial" class="form-control input-sm" type="text" />

                                    @Html.ValidationMessageFor(model => model.Material, "", new { @class = "text-danger" })
                                </td>
                            </tr>

                            <tr>
                                <th width="15%">Item Category</th>
                                <td width="35%">
                                    <div class="dropdown">
                                        <select id="drpCategory" class="form-control  col-sm-6" style="margin-bottom: 5px;">
                                            <option value="-1" lang="en">-Select-</option>
                                        </select>
                                       
                                    </div>
                                </td>

                                <th width="15%">Item Subcategory</th>
                                <td width="35%">
                                    <div class="dropdown">
                                        <select id="drpSubCategory" class="form-control  col-sm-6" style="margin-bottom: 5px;">
                                            <option value="-1" lang="en">-Select-</option>
                                        </select>

                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <th width="15%">Color</th>
                                <td width="35%">
                                    <div class="dropdown">
                                        <select id="drpColor" class="form-control  col-sm-6" style="margin-bottom: 5px;">
                                            <option value="-1" lang="en">-Select-</option>
                                        </select>
                                    </div>


                                </td>

                                <th width="15%">UOM</th>
                                <td width="35%">
                                    <div class="dropdown">
                                        <select id="drpUOM" class="form-control  col-sm-6" style="margin-bottom: 5px;">
                                            <option value="-1" lang="en">-Select-</option>
                                        </select>
                                        
                                    </div>

                                </td>
                            </tr>
                            <tr>
                                <th width="15%">HSN Code</th>
                                <td width="35%">
                                    <div>
                                        @*@Html.EditorFor(model => model.HSNCODE, new { htmlAttributes = new { @class = "form-control input-sm ",@id= "txtItemHSN" } })*@
                                        <input id="txtItemHSN" class="form-control input-sm" type="text" />
                                        @Html.ValidationMessageFor(model => model.HSNCODE, "", new { @class = "text-danger" })
                                    </div>

                                </td>
                                <th width="15%">GST Rate</th>
                                <td width="35%">

                                    <div>
                                        @*@Html.EditorFor(model => model.GSTRate, new { htmlAttributes = new { @class = "form-control input-sm",@id= "txtGSTRate" } })*@
                                        <input id="txtGSTRate" class="form-control input-sm" type="text" />

                                        @Html.ValidationMessageFor(model => model.GSTRate, "", new { @class = "text-danger" })
                                    </div>

                                </td>
                            </tr>
                            <tr>

                                <th width="15%">Purchase Cost</th>
                                <td width="35%">
                                    <div class="input-group">

                                        <span class="input-group-addon">
                                            &#8377;<i class="fa fa-percent"></i>
                                        </span>
                                        @*@Html.EditorFor(model => model.PurchaseCost, new { htmlAttributes = new { @class = "form-control input-sm",@id= "txtItemPurchaseCost" } })*@
                                        <input id="txtItemPurchaseCost" class="form-control input-sm" type="text" />
                                        <span class="input-group-addon">.00</span>
                                        @Html.ValidationMessageFor(model => model.PurchaseCost, "", new { @class = "text-danger" })


                                    </div>
                                </td>
                                <th width="15%">Selling Price</th>
                                <td width="35%">
                                    <div class="input-group">

                                        <span class="input-group-addon">&#8377;</span>
                                        @*@Html.EditorFor(model => model.SellingPrice, new { htmlAttributes = new { @class = "form-control input-sm",@id= "txtItemSellingCost" } })*@
                                        <input id="txtItemSellingCost" class="form-control input-sm" type="text" />
                                        <span class="input-group-addon">.00</span>
                                        @Html.ValidationMessageFor(model => model.SellingPrice, "", new { @class = "text-danger" })

                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>



                </div>
            }
            <!-- /.box-header -->
            <!-- /.box-body -->
        </div>
        <!-- /.box -->
    </div>
</section>

@*above code is off Item Information*@

