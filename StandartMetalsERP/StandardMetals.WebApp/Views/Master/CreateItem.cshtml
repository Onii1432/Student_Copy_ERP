@model StandardMetals.MODEL.ItemMasterMVCModal

@Scripts.Render("~/bower_componentsJS")
@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/jqueryval")


<div class="modal-dialog" style="height: 750px;">
