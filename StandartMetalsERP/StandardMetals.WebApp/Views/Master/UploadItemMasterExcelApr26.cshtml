@section scripts {
    <script>
        (function () {
            var button = document.getElementById("btnDownloadTemplate");

            if (!button) return;

            button.addEventListener("click", function () {
                var masterType = document.getElementById("MasterType").value;

                if (masterType !== "ItemMaster") {
                    alert("Please select Item Master.");
                    return;
                }

                var html = '<html><head><meta charset="utf-8"></head><body><table border="1"><tr><th>Item Code</th><th>Item Name</th><th>Material</th><th>HSN-Code</th><th>GST Rate</th><th>Purchase Cost</th><th>Selling Price</th><th>Category</th><th>Sub Category</th><th>Manufacture</th><th>Colour</th><th>Unit</th></tr></table></body></html>';

                var blob = new Blob(["\ufeff", html], { type: "application/vnd.ms-excel;charset=utf-8;" });
                var url = window.URL.createObjectURL(blob);
                var link = document.createElement("a");

                link.href = url;
                link.download = "ItemMaster_Template.xls";
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);

                setTimeout(function () {
                    window.URL.revokeObjectURL(url);
                }, 1000);
            });
        })();
    </script>
}
