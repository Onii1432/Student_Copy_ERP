
@{
    ViewBag.Title = "Upload Item Master Excel";
}

<section id="Test">
    <div class="col-lg-12 col-md-12">
        <div class="box box-info">
            <div class="box-header with-border">
                <h3 class="box-title">Upload Item Master Excel</h3>
                <div class="box-tools pull-right">
                    <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                </div>
            </div>

            <div class="box-body">
                @using (Html.BeginForm("UploadItemMasterExcelApr26", "Master", FormMethod.Post, new { id = "uploadForm", enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label>Select Master</label>
                                    </div>
                                    <div class="col-md-6">
                                        <select name="MasterType" id="MasterType" class="form-control" required>
                                            <option value="ItemMaster" selected>Item Master</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <button type="button" id="btnDownloadTemplate" class="btn btn-primary" style="white-space:nowrap;">Download Template</button>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label>Attach Excel File</label>
                                    </div>
                                    <div class="col-md-6">
                                        <input type="file" name="ExcelFile" class="form-control" accept=".xls,.xlsx" required />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 text-center" style="margin-top:20px;">
                            <button type="submit" class="btn btn-success">Upload</button>
                            @Html.ActionLink("Back", "ItemList17Dec", "Master", null, new { @class = "btn btn-primary" })
                        </div>
                    </div>
                }

                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-info" style="margin-top:15px;">@ViewBag.Message</div>
                }
            </div>
        </div>
    </div>
</section>

<section id="UploadResult">
    <div class="col-lg-12 col-md-12">
        <div class="box box-info">
            <div class="box-header with-border">
                <h3 class="box-title">Upload Result</h3>
                <div class="box-tools pull-right">
                    <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                </div>
            </div>

            <div class="box-body">
                <div class="row" style="margin-bottom:10px;">
                    <div class="col-md-6">
                        <div style="border:1px solid #c8e6c9;padding:10px;">
                            <b style="color:green;">Success Count</b>
                            <h3>@(ViewBag.SuccessCount ?? 0)</h3>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div style="border:1px solid #ffcdd2;padding:10px;">
                            <b style="color:red;">Fail Count</b>
                            <h3>@(ViewBag.FailCount ?? 0)</h3>
                        </div>
                    </div>
                </div>

                @if (ViewBag.FailCount != null && Convert.ToInt32(ViewBag.FailCount) > 0)
                {
                    @Html.ActionLink("Download Fail Records", "DownloadFailItemMasterExcelApr26", "Master", null, new { @class = "btn btn-info" })
                }
            </div>
        </div>
    </div>
</section>

