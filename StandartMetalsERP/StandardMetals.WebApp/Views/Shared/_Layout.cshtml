                        @*below code is for bindin master and sub master menu*@
                        @{
                            List<StandardMetals.MODEL.LoginDetailsModel> menuDt = (List<StandardMetals.MODEL.LoginDetailsModel>)Session["MenuSubMenu"];
                            var masterMenu = menuDt.Select(m => new { m.MenuName, m.MasterMenuId }).Distinct();

                        }

                        @foreach (var data in masterMenu)
                        {
                            <li class="treeview">
                                <a href="#">
                                    <i class="fa fa-circle-o text-aqua"></i><span> @data.MenuName </span>
                                    <span class="pull-right-container">
                                        <i class="fa fa-angle-left pull-right"></i>
                                    </span>
                                </a>
                                @{
                                    var submenu = menuDt.Select(m => new { m.SubMenuName, m.MasterMenuId, m.SubMasterMenuId, m.MenuLink }).Distinct().Where(m => m.MasterMenuId == data.MasterMenuId);

                                }
                                <ul class="treeview-menu">
                                    @foreach (var subdata in submenu)
                                    {
                                        <li>
                                            <a href="@subdata.MenuLink">
                                                <i class="fa fa-circle-o"></i>
                                                @Convert.ToString(subdata.SubMenuName)

                                            </a>
                                        </li>
                                    }
                                </ul>

                            </li>

                        }


                    </ul>
