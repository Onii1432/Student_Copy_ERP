
@model StandardMetals.MODEL.ItemMaster_Modal_AprBtch

<div class="modal-dialog modal-lg custom-modal-sm">
    <div class="modal-content">

        <div class="modal-header custom-header" style="display:flex;">
            <h2>Add New Item</h2>
            <button type="button" class="close" data-dismiss="modal" style="margin-left:auto;">&times;</button>
        </div>

        <div class="modal-body" style="padding-bottom:0px">

            <div class="box box-info">
                <div class="box-body">
                    <div class="formcolor section-box">

                        @using (Html.BeginForm("AddNewItem17Dec", "MasterCsharp", FormMethod.Post, new { id = "UpdateId" }))
                        {
                            @Html.AntiForgeryToken()

                            <div class="form-horizontal">

                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                <div class="row">

                                    <div class="col-md-2">
                                        @Html.LabelFor(model => model.ItemCode, htmlAttributes: new { @class = "control-label" })
                                    </div>

                                    <div class="col-md-4">
                                        @Html.EditorFor(model => model.ItemCode, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                        @Html.ValidationMessageFor(model => model.ItemCode, "", new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-2">
                                        @Html.LabelFor(model => model.ItemName, "Name", htmlAttributes: new { @class = "control-label" })
                                    </div>

                                    <div class="col-md-4">
                                        @Html.EditorFor(model => model.ItemName, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.ItemName, "", new { @class = "text-danger" })
                                    </div>

                                </div>

                                <div class="row">

                                    <div class="col-md-2">
                                        @Html.LabelFor(model => model.ManufactureId, "Manufacturer", htmlAttributes: new { @class = "control-label" })
                                    </div>

                                    <div class="col-md-4">
                                        @Html.DropDownListFor(model => model.ManufactureId, new SelectList(ViewBag.Manufacturers, "ManufactureId", "ManufactureName"), "Select", new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.ManufactureId, "", new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-2">
                                        @Html.LabelFor(model => model.Material, htmlAttributes: new { @class = "control-label" })
                                    </div>

                                    <div class="col-md-4">
                                        @Html.EditorFor(model => model.Material, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.Material, "", new { @class = "text-danger" })
                                    </div>

                                </div>

                                <div class="row">

                                    <div class="col-md-2">
                                        @Html.LabelFor(model => model.CategoryId, "Category", htmlAttributes: new { @class = "control-label" })
                                    </div>

                                    <div class="col-md-4">
                                        @Html.DropDownListFor(model => model.CategoryId, new SelectList(ViewBag.Categories, "CategoryId", "CategoryName"), "Select", new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.CategoryId, "", new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-2">
                                        @Html.LabelFor(model => model.SubCategoryId, "SubCategory", htmlAttributes: new { @class = "control-label" })
                                    </div>

                                    <div class="col-md-4">
                                        @Html.DropDownListFor(model => model.SubCategoryId, new SelectList(ViewBag.SubCategories, "SubCategoryId", "SubCategoryName"), "Select", new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.SubCategoryId, "", new { @class = "text-danger" })
                                    </div>

                                </div>

                                <div class="row">

                                    <div class="col-md-2">
                                        @Html.LabelFor(model => model.ColourId, "Colour", htmlAttributes: new { @class = "control-label" })
                                    </div>

                                    <div class="col-md-4">
                                        @Html.DropDownListFor(model => model.ColourId, new SelectList(ViewBag.ColourList, "ColourId", "ColourName"), "Select", new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.ColourId, "", new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-2">
                                        @Html.LabelFor(model => model.UnitId, "Unit", htmlAttributes: new { @class = "control-label" })
                                    </div>

                                    <div class="col-md-4">
                                        @Html.DropDownListFor(model => model.UnitId, new SelectList(ViewBag.UnitList, "UnitId", "UnitName"), "Select", new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.UnitId, "", new { @class = "text-danger" })
                                    </div>

                                </div>

                                <div class="row">

                                    <div class="col-md-2">
                                        @Html.LabelFor(model => model.HSNCODE, "HSN-Code", htmlAttributes: new { @class = "control-label" })
                                    </div>

                                    <div class="col-md-4">
                                        @Html.EditorFor(model => model.HSNCODE, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.HSNCODE, "", new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-2">
                                        @Html.LabelFor(model => model.GSTRate, "GST Rate", htmlAttributes: new { @class = "control-label" })
                                    </div>

                                    <div class="col-md-4">
                                        @Html.EditorFor(model => model.GSTRate, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.GSTRate, "", new { @class = "text-danger" })
                                    </div>

                                </div>

                                <div class="row">

                                    <div class="col-md-2">
                                        @Html.LabelFor(model => model.PurchaseCost, htmlAttributes: new { @class = "control-label" })
                                    </div>

                                    <div class="col-md-4">
                                        @Html.EditorFor(model => model.PurchaseCost, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.PurchaseCost, "", new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-2">
                                        @Html.LabelFor(model => model.SellingPrice, htmlAttributes: new { @class = "control-label" })
                                    </div>

                                    <div class="col-md-4">
                                        @Html.EditorFor(model => model.SellingPrice, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.SellingPrice, "", new { @class = "text-danger" })
                                    </div>

                                </div>

                                <div class="form-group">
                                    <div class="modal-footer justify-content-end">
                                        <input type="submit" value="Save" class="btn btn-success" />
                                    </div>
                                </div>

                            </div>
                        }

                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script>

    $(document).ready(function () {

        $("#UpdateId").removeData("validator");
        $("#UpdateId").removeData("unobtrusiveValidation");
        $.validator.unobtrusive.parse("#UpdateId");

        $.validator.addMethod("greaterThan", function (value, element) {
            return parseFloat(value) > parseFloat($("#PurchaseCost").val());
        }, "Selling Price must be greater than Purchase Cost");

        $("#SellingPrice").rules("add", {
            greaterThan: true
        });

        $("#UpdateId select").select2({
            width: "100%",
            placeholder: "Select",
            closeOnSelect: true,
            allowClear: true,
            dropdownParent: $("#myModal .modal-content")
        });

        $("#CategoryId").change(function () {

            var categoryId = $(this).val();
            var subCategory = $("#SubCategoryId");

            subCategory.empty();

            subCategory.append($("<option></option>").val("").text("Select"));

            if (!categoryId) {
                subCategory.val("").trigger("change");
                return;
            }

            $.ajax({
                url: '@Url.Action("GetSubCategoryN", "MasterCsharp")',
                type: "GET",
                data: { id: categoryId },

                success: function (data) {

                    $.each(data, function (i, item) {
                        subCategory.append($("<option></option>").val(item.SubCategoryId).text(item.SubCategoryName));
                    });

                    subCategory.trigger("change.select2");
                },

                error: function () {
                    alert("Unable to load sub categories.");
                }
            });

        });

        $("#UpdateId").submit(function (e) {

            e.preventDefault();

            if (!$(this).valid()) {
                return false;
            }

            $.ajax({

                url: this.action,
                type: "POST",
                data: $(this).serialize(),

                success: function (response) {

                    if (response.success) {

                        alert(response.message + "\n\nGenerated ItemCode : " + response.code);

                        location.reload();

                    } else {

                        $.each(response.errors, function (fieldName, messages) {

                            $("span[data-valmsg-for='" + fieldName + "']")
                                .removeClass("field-validation-valid")
                                .addClass("field-validation-error")
                                .text(messages[0]);

                        });

                    }

                },

                error: function () {
                    alert("Error while saving item.");
                }

            });

            return false;

        });

    });

</script>

<style>

    .row {
        padding: 10px;
    }

    .section-box {
        padding-top: 5px;
    }

    .modal-body {
        padding-top: 5px;
    }
</style>
