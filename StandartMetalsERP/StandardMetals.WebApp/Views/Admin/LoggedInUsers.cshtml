@model List<StandardMetals.MODEL.LoggedInUserModelApril26>

@{
    ViewBag.Title = "Logged In Users";
}

<section class="content">

    <div class="box box-primary">

        <div class="box-header with-border">

            <h3 class="box-title">
                <i class="fa fa-users"></i>
                &nbsp; Logged In Users
            </h3>

        </div>

        <div class="box-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover">

                    <thead>

                        <tr>

                            <th style="width:10%; text-align:center; font-size:16px; background-color:#eaf4fb;">
                                #
                            </th>

                            <th style="width:45%; font-size:16px; background-color:#eaf4fb;">
                                <i class="fa fa-user"></i>
                                &nbsp; User Name
                            </th>

                            <th style="width:45%; text-align:center; font-size:16px; background-color:#eaf4fb;">
                                <i class="fa fa-cogs"></i>
                                &nbsp; Action
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Count > 0)
                        {
                            int srNo = 1;

                            foreach (var item in Model)
                            {
                                <tr>

                                    <td style="text-align:center; vertical-align:middle;">
                                        <strong>
                                            @srNo
                                        </strong>
                                    </td>

                                    <td style="vertical-align:middle;">

                                        <i class="fa fa-user-circle"
                                           style="font-size:20px; margin-right:8px;">
                                        </i>

                                        <strong>
                                            @item.UserName
                                        </strong>

                                    </td>

                                    <td style="text-align:center; vertical-align:middle;">

                                        @if (item.IsLoggedIn)
                                        {
                                            <form action="@Url.Action("LogoutLoginUser", "Admin")"
                                                  method="post"
                                                  style="display:inline;">

                                                <input type="hidden"
                                                       name="LoginUserId"
                                                       value="@item.LoginUserId" />

                                                <button type="submit"
                                                        class="btn btn-danger btn-sm"
                                                        onclick="return confirm('Are you sure you want to logout this user?');">

                                                    <i class="fa fa-sign-out"></i>
                                                    Logout

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <span class="label label-default"
                                                  style="font-size:11px; padding:6px 10px;">

                                                <i class="fa fa-minus-circle"></i>
                                                No Action

                                            </span>
                                        }

                                    </td>

                                </tr>

                                srNo++;
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="3"
                                    style="text-align:center; padding:30px;">

                                    <i class="fa fa-users"
                                       style="font-size:35px; opacity:0.5;">
                                    </i>

                                    <br />
                                    <br />

                                    <span class="text-muted">
                                        No users found.
                                    </span>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</section>